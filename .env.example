# Copy to .env and fill in. Never commit .env. The repo may be public.

# Postgres connection string. Local example:
# postgresql://steady:steady@localhost:5432/steady
DATABASE_URL=

# Asked once per device, then remembered for about a year.
# At least 4 characters. Do not use a placeholder in production.
APP_PASSCODE=

# Bearer token for the coach read API. Leave blank to disable that route.
COACH_API_TOKEN=

# Bearer token for the home-screen widget. Separate from the coach token.
WIDGET_TOKEN=

# Read-only Nightscout. Leave both blank to hide the glucose card.
# GET {NIGHTSCOUT_URL}/api/v1/entries.json?token=...&count=1
NIGHTSCOUT_URL=
NIGHTSCOUT_TOKEN=

# OpenAI-compatible chat completions. Leave the key blank for manual meal entry.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Set by Render. Local dev can omit it.
# PORT=3000
# NODE_ENV=development
